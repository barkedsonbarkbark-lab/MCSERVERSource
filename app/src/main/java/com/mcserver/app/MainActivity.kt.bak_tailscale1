                                Text("No server log output yet.", color = Color(0xFF7F8A96), style = MaterialTheme.typography.bodySmall)
                            } else {
                                logs.forEach { line ->
                                    Text(line, color = Color(0xFFD7DEE7), style = MaterialTheme.typography.bodySmall)
