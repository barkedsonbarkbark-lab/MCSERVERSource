# Build-time Android tunnel configuration
# Pass these as Gradle project properties (for example: -PRENDER_BASE_URL=...)
# PaperMC requests identify the app with this contact URL; point it at the public app page or support page.
MCSERVER_CONTACT_URL=https://play.google.com/store/apps/details?id=com.mcserver.app
RENDER_BASE_URL=https://YOUR-RELAY-HOST
RENDER_TUNNEL_TOKEN=replace-with-a-long-random-token

# Relay service deployment
MCSERVER_TOKEN=replace-with-the-same-long-random-token
PORT=10000
PUBLIC_JAVA_PORT=25565
PUBLIC_BEDROCK_PORT=19132
